<Window x:Class="LaserWelderApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LaserWelderApp"
        xmlns:vm="clr-namespace:LaserWelderApp.ViewModels"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="레이저 용접 시스템 - 설비 제어 &amp; 작업 이력 HMI" 
        Height="780" Width="1200"
        MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#E8ECEF"
        FontFamily="Malgun Gothic, Segoe UI, sans-serif">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DropShadowEffect x:Key="SubtleShadow" BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.12"/>
        <DropShadowEffect x:Key="ButtonShadow" BlurRadius="6" Direction="270" ShadowDepth="3" Opacity="0.2"/>

        <!-- 입력 텍스트박스 스타일 -->
        <Style x:Key="IndustrialInputBox" TargetType="TextBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1C2833"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Effect="{StaticResource SubtleShadow}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0288D1"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 실적 입력 폼 전용 스타일 -->
        <Style x:Key="FormInputBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 3x3 프리셋 버튼 스타일 -->
        <Style x:Key="PresetButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="66"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Background" Value="#DDE4EB"/>
            <Setter Property="BorderBrush" Value="#BCC8D4"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Effect="{StaticResource ButtonShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CFDCE7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#B0BEC5"/>
                                <Setter TargetName="btnBorder" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 하단 액션 버튼 스타일 -->
        <Style x:Key="RoundActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="115"/>
            <Setter Property="Height" Value="62"/>
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="31"
                                Effect="{StaticResource ButtonShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 상단 탭 라디오 버튼 스타일 -->
        <Style x:Key="NavTabStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="NavTabs"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder" Background="Transparent" CornerRadius="18" Padding="18,8" BorderThickness="1.5" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="tabBorder" Property="Effect" Value="{StaticResource SubtleShadow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 불리언/인덱스 가시성 변환용 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0. 상단 헤더 & 네비게이션 탭 -->
            <RowDefinition Height="90"/>
            <!-- 1. 메인 뷰 영역 (탭 전환) -->
            <RowDefinition Height="*"/>
            <!-- 2. 최하단 상태바 -->
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- ================= 0. 상단 헤더 & 탭 메뉴 ================= -->
        <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 좌측 로고 및 탭 선택 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="23" Background="#0284C7" Margin="0,0,14,0" Effect="{StaticResource SubtleShadow}">
                        <Path Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z"/>
                    </Border>

                    <!-- 3개 메인 탭 전환 버튼 -->
                    <Border Background="#E2E8F0" CornerRadius="20" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource NavTabStyle}" Content="기능 설정 (파라미터)" IsChecked="True"
                                         Command="{Binding SwitchTabCommand}" CommandParameter="0"/>
                            <RadioButton Style="{StaticResource NavTabStyle}" Content="작업 실적 입력" 
                                         Command="{Binding SwitchTabCommand}" CommandParameter="1"/>
                            <RadioButton Style="{StaticResource NavTabStyle}" Content="통계 및 차트 이력" 
                                         Command="{Binding SwitchTabCommand}" CommandParameter="2"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 중앙 타이틀 -->
                <TextBlock Grid.Column="1" Text="레이저 용접 시스템" 
                           FontSize="32" 
                           FontWeight="ExtraBold" 
                           Foreground="#0284C7"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#93C5FD" Opacity="0.4"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- 우측 상단 도움말 버튼 -->
                <Button Grid.Column="2" Command="{Binding HelpCommand}"
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Padding="18,7"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1.5"
                        Background="#FFFFFF">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="18"/>
                        </Style>
                    </Button.Resources>
                    <TextBlock Text="도움말" FontSize="16" FontWeight="SemiBold" Foreground="#64748B"/>
                </Button>
            </Grid>
        </Border>

        <!-- ================= 1. 메인 뷰 컨테이너 ================= -->
        <Grid Grid.Row="1">

            <!-- [뷰 1] 기능 설정 (파라미터 HMI 화면 - 기존 첨부이미지 화면) -->
            <Grid x:Name="ViewParameterSetup">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="88"/>
                </Grid.RowDefinitions>

                <!-- 중앙 입력 & 프리셋 영역 -->
                <Grid Grid.Row="0" Margin="30,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 좌측: 파라미터 입력창 -->
                    <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1.5" Padding="28,16" Effect="{StaticResource SubtleShadow}">
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="스캔 속도" FontSize="22" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource IndustrialInputBox}"
                                     Text="{Binding ScanSpeed, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.#}}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="mm/s" FontSize="20" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="16,0,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="스캔 폭" FontSize="22" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource IndustrialInputBox}"
                                     Text="{Binding ScanWidth, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.00}}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" FontSize="20" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="16,0,0,0"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="최대 출력" FontSize="22" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource IndustrialInputBox}"
                                     Text="{Binding MaxPower, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="W" FontSize="20" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="16,0,0,0"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="사용률" FontSize="22" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource IndustrialInputBox}"
                                     Text="{Binding DutyCycle, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}"/>
                            <TextBlock Grid.Row="6" Grid.Column="2" Text="%" FontSize="20" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="16,0,0,0"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="주파수" FontSize="22" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource IndustrialInputBox}"
                                     Text="{Binding Frequency, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}"/>
                            <TextBlock Grid.Row="8" Grid.Column="2" Text="Hz" FontSize="20" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- 우측: 적정 값 3x3 프리셋 버튼 -->
                    <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1.5" Padding="18" Effect="{StaticResource SubtleShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#3B82F6" CornerRadius="10" Margin="4,0,4,10" Effect="{StaticResource SubtleShadow}">
                                <TextBlock Text="적  정  값" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <Grid Grid.Row="1" Margin="2,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource PresetButtonStyle}" Command="{Binding SelectPresetCommand}" CommandParameter="1">
                                    <StackPanel HorizontalAlignment="Center"><TextBlock Text="1" FontSize="18" FontWeight="Bold"/><TextBlock Text="기능 설정" FontSize="13" Foreground="#475569"/></StackPanel>
                                </Button>
                                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource PresetButtonStyle}" Command="{Binding SelectPresetCommand}" CommandParameter="2">
                                    <StackPanel HorizontalAlignment="Center"><TextBlock Text="2" FontSize="18" FontWeight="Bold"/><TextBlock Text="기능 설정" FontSize="13" Foreground="#475569"/></StackPanel>
                                </Button>
                                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource PresetButtonStyle}" Command="{Binding SelectPresetCommand}" CommandParameter="3">
                                    <StackPanel HorizontalAlignment="Center"><TextBlock Text="3" FontSize="18" FontWeight="Bold"/><TextBlock Text="기능 설정" FontSize="13" Foreground="#475569"/></StackPanel>
                                </Button>

                                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource PresetButtonStyle}" Command="{Binding SelectPresetCommand}" CommandParameter="4">
                                    <StackPanel HorizontalAlignment="Center"><TextBlock Text="4" FontSize="18" FontWeight="Bold"/><TextBlock Text="기능 설정" FontSize="13" Foreground="#475569"/></StackPanel>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource PresetButtonStyle}" Command="{Binding SelectPresetCommand}" CommandParameter="5">
                                    <StackPanel HorizontalAlignment="Center"><TextBlock Text="5" FontSize="18" FontWeight="Bold"/><TextBlock Text="기능 설정" FontSize="13" Foreground="#475569"/></StackPanel>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource PresetButtonStyle}" Command="{Binding SelectPresetCommand}" CommandParameter="6">
                                    <StackPanel HorizontalAlignment="Center"><TextBlock Text="6" FontSize="18" FontWeight="Bold"/><TextBlock Text="기능 설정" FontSize="13" Foreground="#475569"/></StackPanel>
                                </Button>

                                <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource PresetButtonStyle}" Command="{Binding SelectPresetCommand}" CommandParameter="7">
                                    <StackPanel HorizontalAlignment="Center"><TextBlock Text="7" FontSize="18" FontWeight="Bold"/><TextBlock Text="기능 설정" FontSize="13" Foreground="#475569"/></StackPanel>
                                </Button>
                                <Button Grid.Row="2" Grid.Column="1" Command="{Binding SelectPresetCommand}" CommandParameter="8">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PresetButtonStyle}">
                                            <Setter Property="BorderBrush" Value="#F59E0B"/>
                                            <Setter Property="Background" Value="#FEF3C7"/>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="8" FontSize="18" FontWeight="ExtraBold" Foreground="#D97706" HorizontalAlignment="Center"/>
                                        <TextBlock Text="(0-8mm)" FontSize="13" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource PresetButtonStyle}" Command="{Binding SelectPresetCommand}" CommandParameter="9">
                                    <StackPanel HorizontalAlignment="Center"><TextBlock Text="9" FontSize="18" FontWeight="Bold"/><TextBlock Text="기능 설정" FontSize="13" Foreground="#475569"/></StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 하단 액션 버튼 -->
                <Border Grid.Row="1" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0">
                        <Button Style="{StaticResource RoundActionButtonStyle}" Command="{Binding LoadCommand}">
                            <TextBlock Text="불러옴" Foreground="#DC2626" FontSize="20" FontWeight="Bold"/>
                        </Button>
                        <Button Style="{StaticResource RoundActionButtonStyle}" Command="{Binding SaveCommand}">
                            <TextBlock Text="저장" Foreground="#D97706" FontSize="20" FontWeight="Bold"/>
                        </Button>
                        <Button Style="{StaticResource RoundActionButtonStyle}" Command="{Binding ResetCommand}">
                            <TextBlock Text="되돌림" Foreground="#0284C7" FontSize="20" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- [뷰 2] 작업 실적 수기 입력 화면 -->
            <Grid x:Name="ViewWorkRecordInput" Margin="40,24">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 헤더 안내 -->
                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="12" Padding="20,14" Margin="0,0,0,18" Effect="{StaticResource SubtleShadow}">
                    <StackPanel>
                        <TextBlock Text="작업 실적 및 품질 점검 수기 등록" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="용접 작업 종료 후 실적(수량, 시간, 가스, 실측 비드 폭)을 입력하고 등록하세요. 입력된 데이터는 SQLite에 보관되며 즉시 시계열 차트에 반영됩니다." 
                                   FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 입력 폼 카드 -->
                <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="16" Padding="32,24" Effect="{StaticResource SubtleShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 현재 용접 조건 자동 연동 배지 -->
                        <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="10" Padding="16,10" Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="현재 선택된 용접 조건 자동 반영:" FontWeight="Bold" Foreground="#475569" Margin="0,0,16,0"/>
                                <TextBlock Text="스캔 속도 " Foreground="#64748B"/>
                                <TextBlock Text="{Binding ScanSpeed, StringFormat={}{0:0.#} mm/s}" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,16,0"/>
                                <TextBlock Text="최대 출력 " Foreground="#64748B"/>
                                <TextBlock Text="{Binding MaxPower, StringFormat={}{0:0} W}" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,16,0"/>
                                <TextBlock Text="스캔 폭 " Foreground="#64748B"/>
                                <TextBlock Text="{Binding ScanWidth, StringFormat={}{0:0.00} mm}" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,16,0"/>
                                <TextBlock Text="(조건 변경은 '기능 설정' 탭에서 가능)" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 2열 입력 폼 -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 좌측 컬럼: 생산 실적 관련 -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="1. 실 가동 작업 시간 (분)" FontSize="16" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource FormInputBox}" Text="{Binding InputDuration, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="예: 45 (분 단위로 숫자만 입력)" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,16"/>

                                <TextBlock Text="2. 총 용접 생산 수량 (개)" FontSize="16" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource FormInputBox}" Text="{Binding InputTotalQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="예: 100 (양품 + 불량 전체 수량)" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,16"/>

                                <TextBlock Text="3. 불량 수량 (NG, 개)" FontSize="16" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource FormInputBox}" Text="{Binding InputDefectQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="예: 1 (불량이 없으면 0 입력)" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,16"/>
                            </StackPanel>

                            <!-- 우측 컬럼: 품질 및 환경 관련 -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="4. 보호 가스 유량 (L/min)" FontSize="16" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource FormInputBox}" Text="{Binding InputGasFlow, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="예: 15.0 (아르곤/질소 유량계 눈금)" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,16"/>

                                <TextBlock Text="5. 실측 비드 폭 (mm)" FontSize="16" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource FormInputBox}" Text="{Binding InputMeasuredBeadWidth, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="예: 4.05 (버니어캘리퍼스 측정값)" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,16"/>

                                <TextBlock Text="6. 작업자 성명 / 조" FontSize="16" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource FormInputBox}" Text="{Binding InputOperatorName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="예: 작업자A 또는 주간1조" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,16"/>
                            </StackPanel>
                        </Grid>

                        <!-- 등록 버튼 -->
                        <Button Grid.Row="2" Command="{Binding SaveWorkRecordCommand}" 
                                Height="56" Background="#0284C7" BorderBrush="#0369A1" BorderThickness="1.5" Cursor="Hand" Margin="0,20,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="12"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="작업 일지 등록 및 SQLite 저장" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- [뷰 3] 통계 및 시계열 차트 대시보드 화면 (ScottPlot 5 연동) -->
            <Grid x:Name="ViewChartDashboard" Margin="24,14">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <!-- 1. 요약 KPI 카드 행 -->
                    <RowDefinition Height="90"/>
                    <!-- 2. ScottPlot 차트 영역 -->
                    <RowDefinition Height="*"/>
                    <!-- 3. 최근 이력 테이블 -->
                    <RowDefinition Height="180"/>
                </Grid.RowDefinitions>

                <!-- 1. 통계 요약 카드 4종 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 카드 1: 누적 생산량 -->
                    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" Padding="18,12" Effect="{StaticResource SubtleShadow}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="누적 총 생산량" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding TotalProductionCount, StringFormat={}{0:N0}}" FontSize="24" FontWeight="ExtraBold" Foreground="#0284C7"/>
                                <TextBlock Text=" 개" FontSize="14" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 카드 2: 총 작업 시간 -->
                    <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="12" Padding="18,12" Effect="{StaticResource SubtleShadow}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="총 가동(작업) 시간" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding TotalWorkDurationMinutes, StringFormat={}{0:N0}}" FontSize="24" FontWeight="ExtraBold" Foreground="#10B981"/>
                                <TextBlock Text=" 분" FontSize="14" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 카드 3: 평균 불량률 -->
                    <Border Grid.Column="4" Background="#FFFFFF" CornerRadius="12" Padding="18,12" Effect="{StaticResource SubtleShadow}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="평균 공정 불량률" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding AverageDefectRate, StringFormat={}{0:0.00}}" FontSize="24" FontWeight="ExtraBold" Foreground="#EF4444"/>
                                <TextBlock Text=" %" FontSize="14" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 카드 4: 누적 작업 건수 & 새로고침 -->
                    <Border Grid.Column="6" Background="#FFFFFF" CornerRadius="12" Padding="18,12" Effect="{StaticResource SubtleShadow}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="누적 작업 일지" FontSize="13" FontWeight="SemiBold" Foreground="#64748B"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding TotalRecordCount}" FontSize="24" FontWeight="ExtraBold" Foreground="#8B5CF6"/>
                                    <TextBlock Text=" 건" FontSize="14" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding RefreshChartCommand}" Content="새로고침"
                                    Padding="10,6" Background="#F1F5F9" BorderBrush="#CBD5E1" Cursor="Hand" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 2. ScottPlot 시계열 차트 3분할 탭/그리드 -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <!-- 차트 1: 일별 생산량 & 시간 -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <!-- 차트 2: 스캔속도 & 레이저 출력 -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <!-- 차트 3: 실측 비드 폭 품질 차트 -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 차트 1 패널 -->
                    <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" Padding="10" Effect="{StaticResource SubtleShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📊 일별 생산 수량 및 작업 시간" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="6,4,0,4"/>
                            <sp:WpfPlot Grid.Row="1" x:Name="WpfPlotProduction"/>
                        </Grid>
                    </Border>

                    <!-- 차트 2 패널 -->
                    <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="12" Padding="10" Effect="{StaticResource SubtleShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="⚡ 레이저 출력 &amp; 스캔 속도 이력" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="6,4,0,4"/>
                            <sp:WpfPlot Grid.Row="1" x:Name="WpfPlotProcess"/>
                        </Grid>
                    </Border>

                    <!-- 차트 3 패널 -->
                    <Border Grid.Column="4" Background="#FFFFFF" CornerRadius="12" Padding="10" Effect="{StaticResource SubtleShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="🎯 비드 폭 품질 관리도 (스펙: 4.0mm)" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="6,4,0,4"/>
                            <sp:WpfPlot Grid.Row="1" x:Name="WpfPlotQuality"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 3. 하단 작업 이력 데이터그리드 -->
                <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="12" Padding="14,10" Effect="{StaticResource SubtleShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="📋 최근 작업 실적 이력 (SQLite DB)" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="4,0,0,6"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding WorkRecords}" AutoGenerateColumns="False" 
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" RowHeaderWidth="0" SelectionMode="Single"
                                  BorderThickness="0" FontSize="13">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="작업 일시" Binding="{Binding FullDateTimeString}" Width="150"/>
                                <DataGridTextColumn Header="작업자" Binding="{Binding OperatorName}" Width="90"/>
                                <DataGridTextColumn Header="프리셋" Binding="{Binding PresetId, StringFormat={}#{0}}" Width="70"/>
                                <DataGridTextColumn Header="스캔 속도" Binding="{Binding ScanSpeed, StringFormat={}{0:0.#} mm/s}" Width="100"/>
                                <DataGridTextColumn Header="레이저 출력" Binding="{Binding MaxPower, StringFormat={}{0:0} W}" Width="100"/>
                                <DataGridTextColumn Header="작업 시간" Binding="{Binding WorkDuration, StringFormat={}{0} 분}" Width="90"/>
                                <DataGridTextColumn Header="생산 수량" Binding="{Binding TotalQuantity, StringFormat={}{0} 개}" Width="90"/>
                                <DataGridTextColumn Header="불량" Binding="{Binding DefectQuantity, StringFormat={}{0} 개}" Width="70"/>
                                <DataGridTextColumn Header="불량률" Binding="{Binding DefectRate, StringFormat={}{0:0.0}%}" Width="80"/>
                                <DataGridTextColumn Header="가스 유량" Binding="{Binding GasFlow, StringFormat={}{0:0.0} L/min}" Width="100"/>
                                <DataGridTextColumn Header="실측 비드 폭" Binding="{Binding MeasuredBeadWidth, StringFormat={}{0:0.00} mm}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= 2. 최하단 상태 표시줄 ================= -->
        <Border Grid.Row="2" Background="#0F172A">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DB: " FontSize="12" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding DbLocation}" FontSize="12" Foreground="#CBD5E1" ToolTip="{Binding DbLocation}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
